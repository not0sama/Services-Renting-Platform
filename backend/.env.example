# ─────────────────────────────────────────────────────────────────────────────
# Hiring & Renting Platform — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# App
ENV=development
DEBUG=True

# Database — PostgreSQL only
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/hiring_renting

# JWT Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI — Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ── Business Rules ────────────────────────────────────────────────────────────
AUTO_RELEASE_HOURS=72
URGENT_SURCHARGE_PERCENT=25.0
OFFER_EXPIRY_DAYS=7
CANCELLATION_FREE_WINDOW_HOURS=24
CANCELLATION_FEE_PERCENT=10.0
FLAT_COMMISSION_RATE=0.15

# Best-match weights: price, distance, rating, ETA  (must sum to 1.0)
BEST_MATCH_WEIGHTS=0.4,0.3,0.2,0.1

# Trust score weights: rating, on_time, completion, response, cancellation_inv
TRUST_SCORE_WEIGHTS=0.3,0.25,0.2,0.15,0.1

# Tier thresholds: Bronze<50, Silver<70, Gold<85, Platinum>=85
TIER_THRESHOLDS=50,70,85

# Tiered commission: min:max:rate,...
COMMISSION_TIERS=0:500:0.20,501:2000:0.15,2001:999999:0.10

# Scheduler
SCHEDULER_POLL_SECONDS=300
