# Gitignore — Hiring & Renting Platform

# ── Python / Backend ──────────────────────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/.env
backend/uploads/*
!backend/uploads/.gitkeep

# ── Node / Frontend ───────────────────────────────────────────────────────────
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/out/
frontend/build/

# ── General ───────────────────────────────────────────────────────────────────
.DS_Store
*.log
*.swp
*.swo
.idea/
.vscode/
*.env
!*.env.example
